int d1, d2, d3, d4;
chan tick, bank;

process Counter() {
  state
    idle, C1, C2, C3, C4, CB;
  commit C1, C2, C3, C4, CB;
  init idle;
  trans
    idle -> C1 {
      sync tick?;
    },
    C1 -> CB {
      guard d1 < 6;
      assign d1 = d1 + 1;
    },
    C1 -> C2 {
      guard d1 == 6;
      assign d1 = 0;
    },
    C2 -> CB {
      guard d2 < 9;
      assign d2 = d2 + 1;
    },
    C2 -> C3 {
      guard d2 == 9;
      assign d2 = 0;
    },
    C3 -> CB {
      guard d3 < 9;
      assign d3 = d3 + 1;
    },
    C3 -> C4 {
      guard d3 == 9;
      assign d3 = 0;
    },
    C4 -> CB {
      guard d4 < 9;
      assign d4 = d4 + 1;
    },
    C4 -> CB {
      guard d4 == 9;
      assign d4 = 0;
    },
    CB -> idle {
      sync bank!;
    };
}

process Ticker() {
  clock p;
  state
    go, wait { p <= 1 };
  urgent go;
  init go;
  trans
    go -> go {
      guard d1 < 6;
      sync tick!;
    },
    go -> wait {
      guard d1 == 6;
      sync tick!;
      assign p = 0;
    },
    wait -> go {
      guard p == 1;
    };
}

