int gate;

process key08() {
  clock x;
  state
    q0, q1, C, done;
  commit C;
  init q0;
  trans
    q0 -> q1 {
      guard x == 8;
      assign x = 0;
    },
    q1 -> C {
      guard x == 8;
      assign x = 0;
    },
    C -> done {
      assign gate = gate + 1;
    };
}

