int gate;

process unlocker() {
  clock y;
  state
    u0, goal;
  init u0;
  trans
    u0 -> goal {
      guard y == 12 && gate == 6;
    };
}

process key04() {
  clock x;
  state
    q0, q1, C, done;
  commit C;
  init q0;
  trans
    q0 -> q1 {
      guard x == 4;
      assign x = 0;
    },
    q1 -> C {
      guard x == 4;
      assign x = 0;
    },
    C -> done {
      assign gate = gate + 1;
    };
}

process key05() {
  clock x;
  state
    q0, q1, C, done;
  commit C;
  init q0;
  trans
    q0 -> q1 {
      guard x == 5;
      assign x = 0;
    },
    q1 -> C {
      guard x == 5;
      assign x = 0;
    },
    C -> done {
      assign gate = gate + 1;
    };
}

