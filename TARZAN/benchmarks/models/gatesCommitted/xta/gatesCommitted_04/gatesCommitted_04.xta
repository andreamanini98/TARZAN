// Auto-generated XTA model for 4 committed keys

int gate;

process key01() {
    clock x;
    state
        q0,
        q1,
        C,
        done;
    commit
        C;
    init
        q0;
    trans
        q0 -> q1 { guard x == 1; assign x = 0; },
        q1 -> C { guard x == 1; assign x = 0; },
        C -> done { assign gate = gate + 1; };
}

