process Doctor() {
  clock x;
  state
    Prepaired { x <= 25 }, GoToPatient, Idle;
  init Idle;
  trans
    Prepaired -> Idle {
      sync medicalCheck!;
      assign docReady = 1;
    },
    GoToPatient -> Prepaired {
      guard x >= 1;
      assign x = 0;
    },
    Idle -> GoToPatient {
      sync patientArrival?;
      assign x = 0, docReady = 0;
    };
}

