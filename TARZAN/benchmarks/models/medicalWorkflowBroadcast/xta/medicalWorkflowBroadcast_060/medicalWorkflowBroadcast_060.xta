int docReady, nurseReady;
chan medicalCheck, checkID;
broadcast chan patientArrival;

process Patient053() {
  clock x, patientFlow;
  state
    Done, WaitingMedicalCheck { x <= 9 }, Waiting { x <= 9 }, Ready { patientFlow <= 9 };
  init Ready;
  trans
    WaitingMedicalCheck -> Done {
      sync medicalCheck?;
    },
    Waiting -> WaitingMedicalCheck {
      sync checkID?;
      assign x = 0;
    },
    Ready -> Waiting {
      guard patientFlow >= 9 && docReady == 1 && nurseReady == 1;
      sync patientArrival!;
      assign x = 0, patientFlow = 0;
    },
    Ready -> Ready {
      sync patientArrival?;
      assign patientFlow = 0;
    };
}

