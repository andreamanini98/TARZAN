process Nurse() {
  clock x;
  state
    atPatient { x <= 5 }, GoToPatient, Idle;
  init Idle;
  trans
    atPatient -> Idle {
      assign nurseReady = 1;
    },
    GoToPatient -> atPatient {
      guard x >= 2;
      sync checkID!;
      assign x = 0;
    },
    Idle -> GoToPatient {
      sync patientArrival?;
      assign x = 0, nurseReady = 0;
    };
}

