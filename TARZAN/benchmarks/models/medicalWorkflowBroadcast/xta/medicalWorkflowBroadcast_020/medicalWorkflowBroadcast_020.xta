      assign x = 0;
    },
    Ready -> Waiting {
      guard patientFlow >= 9 && docReady == 1 && nurseReady == 1;
      sync patientArrival!;
      assign x = 0, patientFlow = 0;
    },
    Ready -> Ready {
      sync patientArrival?;
      assign patientFlow = 0;
    };
}

process Init() {
  state
    Start, Done;
  commit Start;
  init Start;
  trans
    Start -> Done {
      assign docReady = 1, nurseReady = 1;
    };
}

