process Nurse() {
  clock x;
  state
    atPatient { x <= 5 }, GoToPatient, Idle;
  init Idle;
  trans
    atPatient -> Idle {
      assign nurseReady = 1;
    },
    GoToPatient -> atPatient {
      guard x >= 2;
      sync checkID!;
      assign x = 0;
    },
    Idle -> GoToPatient {
      sync patientArrival?;
      assign x = 0, nurseReady = 0;
    };
}

system Doctor, Patient018, Patient019, Init, Patient009, Patient008, Patient020, Patient011, Patient005, Patient004, Patient010, Patient006, Patient012, Patient013, Patient007, Patient003, Patient017, Patient016, Patient002, Patient014, Patient001, Patient015, Nurse;
