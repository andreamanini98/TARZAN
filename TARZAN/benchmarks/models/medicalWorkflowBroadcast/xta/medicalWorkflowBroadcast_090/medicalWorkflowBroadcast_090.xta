// Auto-generated broadcast medicalWorkflow model with 90 patients

broadcast chan patientArrival;
chan checkID, medicalCheck;
int docReady, nurseReady;

process Doctor() {
    clock x;
    state Prepaired { x <= 25 }, GoToPatient, Idle;
    init Idle;
    trans
        Prepaired -> Idle { sync medicalCheck!; assign docReady = 1; },
        GoToPatient -> Prepaired { guard x >= 1; assign x = 0; },
        Idle -> GoToPatient { sync patientArrival?; assign x = 0, docReady = 0; };
}

process Init() {
    state Start, Done;
    commit Start;
    init Start;
    trans
        Start -> Done { assign docReady = 1, nurseReady = 1; };
}

process Nurse() {
    clock x;
    state atPatient { x <= 5 }, GoToPatient, Idle;
    init Idle;
    trans
        atPatient -> Idle { assign nurseReady = 1; },
        GoToPatient -> atPatient { guard x >= 2; sync checkID!; assign x = 0; },
        Idle -> GoToPatient { sync patientArrival?; assign x = 0, nurseReady = 0; };
}

process Patient001() {
    clock x, patientFlow;
    state Done, WaitingMedicalCheck { x <= 9 }, Waiting { x <= 9 }, Ready { patientFlow <= 9 };
    init Ready;
    trans
        WaitingMedicalCheck -> Done { sync medicalCheck?; },
        Waiting -> WaitingMedicalCheck { sync checkID?; assign x = 0; },
        Ready -> Waiting { guard patientFlow >= 9 && docReady == 1 && nurseReady == 1; sync patientArrival!; assign x = 0, patientFlow = 0; },
        Ready -> Ready { sync patientArrival?; assign patientFlow = 0; };
}

