process g4() {
  clock ckG4;
  state
    G401, G411 { ckG4 <= 7 }, G410, G400 { ckG4 <= 7 };
  init G410;
  trans
    G400 -> G401 {
      guard ckG4 >= 7;
      sync qUp!;
      assign qLevel = 1;
    },
    G401 -> G411 {
      sync qG3Up!;
      assign ckG4 = 0;
    },
    G411 -> G401 {
      sync qG3Down?;
    },
    G400 -> G410 {
      sync qG3Up!;
    },
    G410 -> G400 {
      sync qG3Down?;
      assign ckG4 = 0;
    },
    G411 -> G410 {
      guard ckG4 >= 7;
      sync qDown!;
      assign qLevel = 0;
    };
}

process input() {
  clock s;
  state
    Input0 { s <= 19 }, Input1 { s <= 20 }, Input2 { s <= 26 }, Input3 { s <= 60 }, Input4 { s <= 0 };
  init Input0;
  trans
    Input2 -> Input3 {
      guard s == 26;
      sync dDown!;
    },
    Input1 -> Input2 {
      guard s == 20;
      sync ckUp!;
    },
    Input0 -> Input1 {
      guard s == 19;
      sync dUp!;
    },
    Input3 -> Input4 {
      guard s == 60;
      sync ckDown!;
      assign s = 0;
    };
}

system g2, g3, g1, g4, input;
