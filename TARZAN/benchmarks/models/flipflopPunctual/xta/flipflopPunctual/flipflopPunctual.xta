    G2010 -> G2011 {
      guard ckG2 >= 19;
      sync qG2Up!;
    },
    G2000 -> G2001 {
      guard ckG2 >= 19;
      sync qG2Up!;
    },
    G2110 -> G2010 {
      sync qG1Down?;
      assign ckG2 = 0;
    },
    G2111 -> G2101 {
      sync ckDown?;
    },
    G2001 -> G2101 {
      sync qG1Up?;
    },
    G2101 -> G2111 {
      sync ckUp?;
      assign ckG2 = 0;
    },
    G2111 -> G2110 {
      guard ckG2 >= 19;
      sync qG2Down!;
    },
    G2011 -> G2111 {
      sync qG1Up?;
      assign ckG2 = 0;
    };
}

