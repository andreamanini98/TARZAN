process g2() {
  clock ckG2;
  state
    G2001, G2000 { ckG2 <= 19 }, G2011, G2010 { ckG2 <= 19 }, G2101, G2100 { ckG2 <= 19 }, G2111 { ckG2 <= 19 }, G2110;
  init G2101;
  trans
    G2010 -> G2000 {
      sync ckDown?;
      assign ckG2 = 0;
    },
    G2111 -> G2011 {
      sync qG1Down?;
    },
    G2101 -> G2001 {
      sync qG1Down?;
