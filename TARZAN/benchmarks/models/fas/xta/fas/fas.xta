    slot_end { absTime <= 150 }, third_try { absTime <= 137 }, S0 { absTime <= 125 }, second_try { absTime <= 112 }, window_end { absTime <= 9450 }, S1 { absTime <= 100 }, first_try { absTime <= 87 }, idle { absTime <= 79 };
  init idle;
