      guard (gBlockedChannel < 1 || gBlockedChannel > 1) && (gOffSensor < gSensorID || gOffSensor > gSensorID) && medium_1_currentMsg == 4;
      sync RX_4_1!;
    },
    idle -> transmit {
      sync TX_0_1?;
      assign medium_1_currentMsg = 0;
    },
    idle -> transmit {
      sync TX_1_1?;
      assign medium_1_currentMsg = 1;
    },
    idle -> transmit {
      sync TX_2_1?;
      assign medium_1_currentMsg = 2;
    },
    idle -> transmit {
      sync TX_3_1?;
      assign medium_1_currentMsg = 3;
    },
    idle -> transmit {
      sync TX_4_1?;
      assign medium_1_currentMsg = 4;
