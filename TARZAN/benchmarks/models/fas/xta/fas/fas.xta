process blocker() {
  clock x;
  state
    BLOCKED, INIT_BLOCKED, FREE { x <= 64 }, S0;
  urgent S0;
  init S0;
  trans
    INIT_BLOCKED -> FREE {
      assign x = 0, gBlockedChannel = 0 - 1;
    },
    BLOCKED -> BLOCKED {
      guard x >= 64;
      assign x = 0, gBlockedChannel = 0;
    },
    BLOCKED -> BLOCKED {
      guard x >= 64;
      assign x = 0, gBlockedChannel = 1;
    },
    BLOCKED -> BLOCKED {
      guard x >= 64;
      assign x = 0, gBlockedChannel = 2;
    },
    BLOCKED -> BLOCKED {
      guard x >= 64;
      assign x = 0, gBlockedChannel = 3;
    },
    BLOCKED -> FREE {
      guard x >= 64;
      assign x = 0, gBlockedChannel = 0 - 1;
    },
    FREE -> BLOCKED {
      assign x = 0, gBlockedChannel = 0;
    },
    FREE -> BLOCKED {
      assign x = 0, gBlockedChannel = 1;
    },
    FREE -> BLOCKED {
      assign x = 0, gBlockedChannel = 2;
    },
    FREE -> BLOCKED {
      assign x = 0, gBlockedChannel = 3;
    },
    INIT_BLOCKED -> BLOCKED {
      assign x = 0, gBlockedChannel = 0;
    },
    INIT_BLOCKED -> BLOCKED {
      assign x = 0, gBlockedChannel = 1;
    },
    INIT_BLOCKED -> BLOCKED {
      assign x = 0, gBlockedChannel = 2;
    },
    INIT_BLOCKED -> BLOCKED {
      assign x = 0, gBlockedChannel = 3;
    },
    S0 -> INIT_BLOCKED {
      assign gBlockedChannel = 0;
    },
    S0 -> INIT_BLOCKED {
      assign gBlockedChannel = 1;
    },
    S0 -> INIT_BLOCKED {
      assign gBlockedChannel = 2;
    },
    S0 -> INIT_BLOCKED {
      assign gBlockedChannel = 3;
    },
    S0 -> FREE {
      assign x = 0, gBlockedChannel = 0 - 1;
    };
}

system master, slot, switcher, medium_1, medium_0, medium_2, Init, medium_3, centerTR1, window, sensor_1, center, sensor_0, blocker;
