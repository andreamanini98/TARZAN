}

process center() {
  state
    ERROR, S0, S1, S2;
  urgent ERROR, S0;
  init S2;
  trans
    ERROR -> S2 {
      guard center_window == 0;
      assign missedLZ_0 = 0;
    },
    ERROR -> S2 {
      guard center_window == 1;
      assign missedLZ_1 = 0;
    },
    S0 -> ERROR {
      guard center_window == 0 && missedLZ_0 >= 2;
      sync errorDetected!;
    },
    S0 -> ERROR {
      guard center_window == 1 && missedLZ_1 >= 2;
      sync errorDetected!;
    },
    S1 -> S1 {
      sync LZReceived_0?;
    },
    S0 -> S2 {
      guard center_window == 0 && missedLZ_0 < 2;
    },
    S0 -> S2 {
      guard center_window == 1 && missedLZ_1 < 2;
    },
    S2 -> S0 {
      guard gCurrentWindow == 0;
      sync windowTimerReset?;
      assign missedLZ_0 = missedLZ_0 + 1, center_window = 0;
    },
    S2 -> S0 {
      guard gCurrentWindow == 1;
      sync windowTimerReset?;
      assign missedLZ_1 = missedLZ_1 + 1, center_window = 1;
    },
    S1 -> S2 {
      sync windowTimerReset?;
    },
    S2 -> S1 {
      sync LZReceived_0?;
    };
}

