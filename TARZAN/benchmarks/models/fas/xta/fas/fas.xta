int channelLZ, channelCALL, channelREPLZ, channelALARM, TR1Channel, gOffSensor, medium_1_currentMsg, gBlockedChannel, gSensorID, medium_0_currentMsg, medium_2_currentMsg, medium_3_currentMsg, centerTR1_channel, missedLZ_0, missedLZ_1, gCurrentWindow, center_window;
chan TX_0_1, TX_1_1, TX_2_1, TX_3_1, TX_4_1, TX_0_0, TX_1_0, TX_2_0, TX_3_0, TX_4_0, TX_0_2, TX_1_2, TX_2_2, TX_3_2, TX_4_2, TX_0_3, TX_1_3, TX_2_3, TX_3_3, TX_4_3, LZReceived_0;
broadcast chan cycleReset, slotTimerReset, errorDetected, RX_0_1, RX_1_1, RX_2_1, RX_3_1, RX_4_1, RX_0_0, RX_1_0, RX_2_0, RX_3_0, RX_4_0, RX_0_2, RX_1_2, RX_2_2, RX_3_2, RX_4_2, RX_0_3, RX_1_3, RX_2_3, RX_3_3, RX_4_3, windowTimerReset;

process master() {
  clock absTime;
  state
    c3 { absTime <= 9450 }, c1 { absTime <= 9450 }, c2 { absTime <= 9450 }, c0 { absTime <= 9450 };
  init c0;
  trans
    c3 -> c0 {
      guard absTime >= 9450;
      sync cycleReset!;
      assign absTime = 0, channelLZ = 0, channelCALL = 1, channelREPLZ = 2, channelALARM = 3;
    },
    c2 -> c3 {
      guard absTime >= 9450;
      sync cycleReset!;
      assign absTime = 0, channelLZ = 3, channelCALL = 0, channelREPLZ = 1, channelALARM = 2;
    },
    c1 -> c2 {
      guard absTime >= 9450;
      sync cycleReset!;
      assign absTime = 0, channelLZ = 2, channelCALL = 3, channelREPLZ = 0, channelALARM = 1;
    },
    c0 -> c1 {
      guard absTime >= 9450;
      sync cycleReset!;
      assign absTime = 0, channelLZ = 1, channelCALL = 2, channelREPLZ = 3, channelALARM = 0;
    };
}

process slot() {
  clock slotTimer, absTime;
  state
    S0, S1 { slotTimer <= 25 }, S2 { slotTimer <= 25 }, S3 { slotTimer <= 25 };
  urgent S0;
  init S3;
  trans
    S1 -> S0 {
      sync cycleReset?;
      assign absTime = 0, TR1Channel = channelLZ;
    },
    S0 -> S3 {
      sync slotTimerReset!;
      assign slotTimer = 0;
    },
    S1 -> S3 {
      guard slotTimer >= 25 && absTime < 9450;
      sync slotTimerReset!;
      assign slotTimer = 0, TR1Channel = channelLZ;
    },
    S2 -> S1 {
      guard slotTimer >= 25;
      sync slotTimerReset!;
      assign slotTimer = 0, TR1Channel = channelCALL;
    },
    S3 -> S2 {
      guard slotTimer >= 25;
      sync slotTimerReset!;
      assign slotTimer = 0, TR1Channel = channelALARM;
    },
    S0 -> S0 {
      sync cycleReset?;
      assign absTime = 0;
    },
    S2 -> S2 {
      sync cycleReset?;
      assign absTime = 0;
    },
    S3 -> S3 {
      sync cycleReset?;
      assign absTime = 0;
    };
}

process switcher() {
  clock timer;
  state
    DETECTION, SHUTDOWN, S0;
  urgent DETECTION;
  init S0;
  trans
    DETECTION -> SHUTDOWN {
      assign timer = 0;
    },
    SHUTDOWN -> DETECTION {
      sync errorDetected?;
    },
    S0 -> SHUTDOWN {
      assign timer = 0, gOffSensor = 0;
    },
    S0 -> SHUTDOWN {
      assign timer = 0, gOffSensor = 1;
    };
}

process medium_1() {
  state
    transmit, idle;
  urgent transmit;
  init idle;
  trans
    transmit -> idle {
      guard gBlockedChannel == 1 || gOffSensor == gSensorID;
    },
    transmit -> idle {
      guard (gBlockedChannel < 1 || gBlockedChannel > 1) && (gOffSensor < gSensorID || gOffSensor > gSensorID) && medium_1_currentMsg == 0;
      sync RX_0_1!;
    },
    transmit -> idle {
      guard (gBlockedChannel < 1 || gBlockedChannel > 1) && (gOffSensor < gSensorID || gOffSensor > gSensorID) && medium_1_currentMsg == 1;
      sync RX_1_1!;
    },
    transmit -> idle {
      guard (gBlockedChannel < 1 || gBlockedChannel > 1) && (gOffSensor < gSensorID || gOffSensor > gSensorID) && medium_1_currentMsg == 2;
      sync RX_2_1!;
