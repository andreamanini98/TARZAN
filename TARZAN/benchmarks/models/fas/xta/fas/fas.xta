process centerTR1() {
  clock counter;
  state
    S0 { counter <= 8 }, S1, S2;
  urgent S1;
  init S2;
  trans
    S0 -> S2 {
      guard centerTR1_channel == 0;
      sync TX_1_0!;
    },
    S0 -> S2 {
      guard centerTR1_channel == 1;
      sync TX_1_1!;
    },
    S0 -> S2 {
      guard centerTR1_channel == 2;
      sync TX_1_2!;
    },
    S0 -> S2 {
      guard centerTR1_channel == 3;
      sync TX_1_3!;
    },
    S1 -> S0 {
      guard gSensorID == 0;
      sync LZReceived_0!;
      assign missedLZ_0 = 0;
    },
    S1 -> S0 {
      guard gSensorID == 1;
      sync LZReceived_0!;
      assign missedLZ_1 = 0;
    },
    S2 -> S1 {
      guard TR1Channel == 0;
      sync RX_0_0?;
      assign counter = 0, centerTR1_channel = TR1Channel;
    },
    S2 -> S1 {
      guard TR1Channel == 1;
      sync RX_0_1?;
      assign counter = 0, centerTR1_channel = TR1Channel;
    },
    S2 -> S1 {
      guard TR1Channel == 2;
      sync RX_0_2?;
      assign counter = 0, centerTR1_channel = TR1Channel;
    },
    S2 -> S1 {
      guard TR1Channel == 3;
      sync RX_0_3?;
      assign counter = 0, centerTR1_channel = TR1Channel;
    };
}

process window() {
  clock windowTimer;
  state
    S0, S1 { windowTimer <= 75 };
  urgent S0;
  init S1;
  trans
    S0 -> S1 {
      guard gCurrentWindow < 125;
      assign gCurrentWindow = gCurrentWindow + 1;
    },
    S0 -> S1 {
      guard gCurrentWindow == 125;
      assign gCurrentWindow = 0;
    },
    S1 -> S0 {
      guard windowTimer >= 75;
      sync windowTimerReset!;
      assign windowTimer = 0;
    };
}

