int ctr1, ctr2, ctr3, ctr4;

process Boolean03() {
  clock x;
  state
    s0, s1;
  init s0;
  trans
    s0 -> s1 {
      guard x == 3;
      assign x = 0, ctr3 = 1 - ctr3;
    },
    s1 -> s0 {
      guard x == 3;
      assign x = 0, ctr3 = 1 - ctr3;
    };
}

process Boolean02() {
  clock x;
  state
    s0, s1;
  init s0;
  trans
    s0 -> s1 {
      guard x == 2;
      assign x = 0, ctr2 = 1 - ctr2;
    },
    s1 -> s0 {
      guard x == 2;
      assign x = 0, ctr2 = 1 - ctr2;
    };
}

process Boolean01() {
  clock x;
  state
    s0, s1;
  init s0;
  trans
    s0 -> s1 {
      guard x == 1;
      assign x = 0, ctr1 = 1 - ctr1;
    },
    s1 -> s0 {
      guard x == 1;
      assign x = 0, ctr1 = 1 - ctr1;
    };
}

process Boolean04() {
  clock x;
  state
    s0, s1;
  init s0;
  trans
    s0 -> s1 {
      guard x == 4;
      assign x = 0, ctr4 = 1 - ctr4;
    },
    s1 -> s0 {
      guard x == 4;
      assign x = 0, ctr4 = 1 - ctr4;
    };
}

system Boolean03, Boolean02, Boolean01, Boolean04;
