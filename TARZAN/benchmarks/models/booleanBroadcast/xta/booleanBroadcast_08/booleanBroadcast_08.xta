int ctr01, ctr03, ctr02, ctr06, ctr07, ctr05, ctr04, ctr08, parity;
broadcast chan flip;

process Bit01() {
  clock x;
  state
    s0, c0, s1, c1;
  commit c0, c1;
  init s0;
  trans
    s0 -> c0 {
      guard x == 1;
      assign x = 0;
    },
    c0 -> s1 {
      sync flip!;
      assign ctr01 = 1 - ctr01;
    },
    s1 -> c1 {
      guard x == 1;
      assign x = 0;
    },
    c1 -> s0 {
      sync flip!;
      assign ctr01 = 1 - ctr01;
    };
}

