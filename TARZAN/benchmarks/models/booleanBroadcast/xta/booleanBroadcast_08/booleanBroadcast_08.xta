process Bit08() {
  clock x;
  state
    s0, c0, s1, c1;
  commit c0, c1;
  init s0;
  trans
    s0 -> c0 {
      guard x == 8;
      assign x = 0;
    },
    c0 -> s1 {
      sync flip!;
      assign ctr08 = 1 - ctr08;
    },
    s1 -> c1 {
      guard x == 8;
      assign x = 0;
    },
    c1 -> s0 {
      sync flip!;
      assign ctr08 = 1 - ctr08;
    };
