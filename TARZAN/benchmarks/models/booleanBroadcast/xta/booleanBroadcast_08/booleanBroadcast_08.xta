      guard x == 3;
      assign x = 0;
    },
    c0 -> s1 {
      sync flip!;
      assign ctr03 = 1 - ctr03;
    },
    s1 -> c1 {
      guard x == 3;
      assign x = 0;
    },
    c1 -> s0 {
