process Observer() {
  state
    watch;
  init watch;
  trans
    watch -> watch {
      sync flip?;
      assign parity = 1 - parity;
    };
}

system Bit01, Bit03, Bit02, Bit06, Bit07, Bit05, Bit04, Bit08, Observer;
