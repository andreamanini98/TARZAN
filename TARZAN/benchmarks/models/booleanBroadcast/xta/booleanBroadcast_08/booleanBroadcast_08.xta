process Bit04() {
  clock x;
  state
    s0, c0, s1, c1;
  commit c0, c1;
  init s0;
  trans
    s0 -> c0 {
      guard x == 4;
      assign x = 0;
    },
    c0 -> s1 {
      sync flip!;
      assign ctr04 = 1 - ctr04;
    },
    s1 -> c1 {
