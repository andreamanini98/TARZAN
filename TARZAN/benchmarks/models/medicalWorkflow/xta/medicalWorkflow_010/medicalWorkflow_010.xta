process Nurse() {
  clock x;
  state
    atPatient { x <= 5 }, GoToPatient, Idle, L0;
  urgent L0;
  init L0;
  trans
    L0 -> Idle {
      assign nurseReady = 1;
    },
    atPatient -> Idle {
      assign nurseReady = 1;
    },
    GoToPatient -> atPatient {
      guard x >= 2;
      sync checkID!;
      assign x = 0;
    },
    Idle -> GoToPatient {
      sync patientArrivalNurse001?;
      assign x = 0, nurseReady = 0;
    },
    Idle -> GoToPatient {
      sync patientArrivalNurse002?;
      assign x = 0, nurseReady = 0;
    },
    Idle -> GoToPatient {
      sync patientArrivalNurse003?;
