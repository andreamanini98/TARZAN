int parity, ctr01, ctr02, ctr03, ctr04, ctr05, ctr06, ctr07, ctr08;

process Bit01() {
  clock x;
  state s0, c0, d0, s1, c1, d1;
  commit c0, d0, c1, d1;
  init s0;
  trans
    s0 -> c0 { guard x == 1; assign x = 0; },
    c0 -> d0 { assign ctr01 = 1 - ctr01; },
    d0 -> s1 { assign parity = 1 - parity; },
    s1 -> c1 { guard x == 1; assign x = 0; },
    c1 -> d1 { assign ctr01 = 1 - ctr01; },
    d1 -> s0 { assign parity = 1 - parity; };
}

