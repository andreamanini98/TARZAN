process Bit08() {
  clock x;
  state s0, c0, d0, s1, c1, d1;
  commit c0, d0, c1, d1;
  init s0;
  trans
    s0 -> c0 { guard x == 8; assign x = 0; },
    c0 -> d0 { assign ctr08 = 1 - ctr08; },
    d0 -> s1 { assign parity = 1 - parity; },
    s1 -> c1 { guard x == 8; assign x = 0; },
    c1 -> d1 { assign ctr08 = 1 - ctr08; },
    d1 -> s0 { assign parity = 1 - parity; };
}

system Bit01, Bit02, Bit03, Bit04, Bit05, Bit06, Bit07, Bit08;
