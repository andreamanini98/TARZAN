    c0 -> d0 { assign ctr02 = 1 - ctr02; },
    d0 -> s1 { assign parity = 1 - parity; },
    s1 -> c1 { guard x == 2; assign x = 0; },
    c1 -> d1 { assign ctr02 = 1 - ctr02; },
    d1 -> s0 { assign parity = 1 - parity; };
}

