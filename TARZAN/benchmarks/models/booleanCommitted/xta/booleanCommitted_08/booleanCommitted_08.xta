process Bit07() {
  clock x;
  state s0, c0, d0, s1, c1, d1;
  commit c0, d0, c1, d1;
  init s0;
  trans
    s0 -> c0 { guard x == 7; assign x = 0; },
    c0 -> d0 { assign ctr07 = 1 - ctr07; },
    d0 -> s1 { assign parity = 1 - parity; },
    s1 -> c1 { guard x == 7; assign x = 0; },
    c1 -> d1 { assign ctr07 = 1 - ctr07; },
