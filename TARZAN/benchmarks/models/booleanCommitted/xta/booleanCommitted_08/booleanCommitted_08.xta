  commit c0, d0, c1, d1;
  init s0;
  trans
    s0 -> c0 { guard x == 6; assign x = 0; },
    c0 -> d0 { assign ctr06 = 1 - ctr06; },
    d0 -> s1 { assign parity = 1 - parity; },
    s1 -> c1 { guard x == 6; assign x = 0; },
    c1 -> d1 { assign ctr06 = 1 - ctr06; },
    d1 -> s0 { assign parity = 1 - parity; };
